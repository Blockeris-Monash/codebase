{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SubmissionEntry",
  "title": "SubmissionEntry",
  "description": "STAGE 5 of 5  |  produced by: R1  |  consumed by: POST /submit\n\nOne per email, all 520 ids present. Exactly the sample_submission.json shape.",
  "type": "object",
  "required": [
    "category",
    "status",
    "review_reason",
    "has_defect",
    "defect_fields"
  ],
  "additionalProperties": false,
  "properties": {
    "category": {
      "enum": [
        "BL_COMPARISON",
        "SI_REQUEST",
        "INVOICE_QUERY",
        "GENERAL",
        "SPAM"
      ]
    },
    "status": {
      "enum": [
        "OK",
        "MISMATCH",
        "NEEDS_REVIEW"
      ]
    },
    "review_reason": {
      "enum": [
        null,
        "wrong_doc_type",
        "missing_attachment",
        "unreadable",
        "missing_value"
      ]
    },
    "has_defect": {
      "type": "boolean",
      "description": "True if and only if status == MISMATCH."
    },
    "defect_fields": {
      "type": "array",
      "description": "Non-empty only when status == MISMATCH. Scored by exact set equality.",
      "items": {
        "enum": [
          "shipper",
          "consignee",
          "notify_party",
          "port_of_loading",
          "port_of_discharge",
          "container_count",
          "gross_weight_kg"
        ]
      }
    }
  },
  "allOf": [
    {
      "description": "status is NEEDS_REVIEW if and only if review_reason is set",
      "if": {
        "properties": {
          "status": {
            "const": "NEEDS_REVIEW"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review_reason": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "review_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "description": "status is MISMATCH if and only if defect_fields is non-empty",
      "if": {
        "properties": {
          "status": {
            "const": "MISMATCH"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "defect_fields": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "defect_fields": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "description": "status is MISMATCH if and only if has_defect is true",
      "if": {
        "properties": {
          "status": {
            "const": "MISMATCH"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "has_defect": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "has_defect": {
            "const": false
          }
        }
      }
    }
  ]
}
