# Point the loader at either the extracted bundle or the local server.
# The hackathon container publishes on 8081 here (8080 is taken locally).
DATA_DIR=data
# DATA_DIR=http://localhost:8081

# --- Model keys ----------------------------------------------------------
# All OPTIONAL. Nothing in the saved path needs them: the extracts and the
# classifications are saved in results/, and the review app reads
# frontend/results.js. Without a key the live model tests skip.
#
# QWEN_API_KEY    the classifier (backend/classify.py), the Qwen extractor
#                 (backend/extract/qwen.py) and live runs of the orchestrator
# GOOGLE_API_KEY  only the Gemini backup behind Qwen for classify, extract and translate
QWEN_API_KEY=
GOOGLE_API_KEY=

# QWEN_BASE_URL   the team proxy that holds the real key. Ask a teammate.
# QWEN_MODEL      override the default model id
# GEMINI_MODEL    override the default model id
QWEN_BASE_URL=

# --- Classification critic (backend/critic.py) ---------------------------
# OPTIONAL. When the first answer is in doubt, Gemini gives a second opinion.
# By default it uses the Gemini key above. Gemini limits are per Google project
# and per model, so a key from ANOTHER project, or another model, keeps second
# opinions from using up the quota the backup needs when Qwen is down.
# GEMINI_CRITIC_API_KEY=
# GEMINI_CRITIC_MODEL=

# --- Technical reports (backend/reports.py) ------------------------------
# OPTIONAL. When a model needed more than one try, or never answered, a report
# is filed for the admin queue. Without both, reports only go to the log.
# SUPABASE_SERVICE_ROLE_KEY is a SECRET that bypasses row-level security: set
# it on the server only, never in frontend/config.js.
#
# The same key is what backend/reply.py needs to retrieve the company
# guidelines: `policies` has row-level security on with no policy, so nothing
# but the service role can read it. That module used to read SUPABASE_KEY
# instead, which was documented nowhere - so setting only the name below left
# retrieval silently off, with replies drafted from nothing and no error to say
# so. It now accepts either, this one first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Everything else the code reads --------------------------------------
# All OPTIONAL, all with working defaults. Listed because a variable that is
# read but written down nowhere is one nobody can set deliberately.
#
# CORS_ORIGINS            comma-separated origins allowed to call the API.
#                         Default "*", which is right while the page is static
#                         and sends no cookies.
# MAILBOX_DIR             where live mailbox attachments are written.
# LOG_LEVEL               DEBUG, INFO (default), WARNING, ERROR. A value it does
#                         not recognise falls back to INFO rather than silencing
#                         the service.
# QWEN_TIMEOUT_SECONDS    seconds for one Qwen call. Default 15: a healthy call
#                         answers in 5 to 7.
# GEMINI_API_KEY          accepted as well as GOOGLE_API_KEY above; either works.
# SHIP_HAPPENS_VISION     =1 reads the scanned attachments with a vision model.
#                         Off by default so the submitted numbers stay
#                         reproducible.
# SHIP_HAPPENS_RULES_FIRST  =0 turns off reading the seven fields from labels
#                         before calling the model. On by default; turning it
#                         off costs about 12 s per document pair.
# SHIP_HAPPENS_LIVE       =1 lets the tests that reach a model actually run.
#                         Off by default, so a key alone never turns a unit-test
#                         run into billed calls.
