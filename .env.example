# Point the loader at either the extracted bundle or the local server.
# The hackathon container publishes on 8081 here (8080 is taken locally).
DATA_DIR=data
# DATA_DIR=http://localhost:8081

# --- Model keys ----------------------------------------------------------
# Both are OPTIONAL. Nothing in the scored path needs them: extraction reads
# the cached results in results/extracts/, and the rules classify 470 of the
# 520 emails. Without a key the remaining 50 stay unclassified and the live
# model tests skip.
#
# GOOGLE_API_KEY  classification (backend/classify.py) and the Gemini
#                 extractor (backend/extract/gemini.py)
# QWEN_API_KEY    the Qwen extractor (backend/extract/qwen.py), used when
#                 the orchestrator is asked for a live run
GOOGLE_API_KEY=
QWEN_API_KEY=

# --- CORS ----------------------------------------------------------------
# Origins the browser may call this service from, comma-separated. The report
# UI is served from Vercel and the API from Render, so without this the
# browser blocks every POST. Unset means any origin, which suits a public demo.
# CORS_ORIGINS=https://blockeris.vercel.app,http://localhost:5500
