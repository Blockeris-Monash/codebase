# Copy to .env and fill in only the sections you need. .env is gitignored.
#
# Nothing here is required. The tests, the review app and the saved compare path
# all run with the file absent: the extracts and classifications live in
# results/ and the page reads frontend/results.js. Without a key the tests that
# reach a model skip.
#
# On startup the backend prints one line naming what is on, so a value that was
# never set announces itself instead of being found out during a demo:
#   features: reports=on retrieval=on gemini-backup=on critic=on rules-first=on

# Where the dataset lives. A URL instead of a path talks to the organiser server.
DATA_DIR=data
# DATA_DIR=http://localhost:8081


# --- Qwen: classification and live extraction --------------------------------
# QWEN_BASE_URL is the team proxy, so the real upstream key stays out of the
# repository. Ask a teammate for both.
QWEN_API_KEY=
QWEN_BASE_URL=
# QWEN_MODEL=qwen3.8-27b-fp8        # optional, has a default in code
# QWEN_TIMEOUT_SECONDS=15           # optional, one call; a healthy one answers in 5-7


# --- Gemini: the backup behind Qwen, and the classification critic ------------
# Without this there is no second provider when Qwen stalls. GEMINI_API_KEY is
# accepted as well as GOOGLE_API_KEY; either works.
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash     # optional, has a default in code
#
# The critic asks for a second opinion when the first answer is in doubt - about
# one email in a hundred. Gemini limits are per project and per model, so a key
# from ANOTHER project keeps second opinions from using up the quota the backup
# needs on the night Qwen is down.
# GEMINI_CRITIC_API_KEY=
# GEMINI_CRITIC_MODEL=


# --- Supabase: the reports queue and guidelines retrieval ---------------------
# SUPABASE_SERVICE_ROLE_KEY is a SECRET. It bypasses row-level security, so it
# belongs on a server and never in frontend/config.js. One key switches on the
# technical reports queue and the company-guidelines retrieval behind the
# drafted replies.
#
# backend/reply.py originally read this under the name SUPABASE_KEY, added the
# same day by someone else. It accepts either now, this one first - so there is
# one secret, in one place, to rotate.
#
# The publishable key the browser uses is a different key and lives literally in
# frontend/config.js. The page has no build step, so nothing here reaches it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# --- Switches, all off or defaulted unless set -------------------------------
# SHIP_HAPPENS_VISION=1             # let backend/extract/vision.py read scanned attachments
#                                   # in an offline pass (results/vision/, then
#                                   # cli.make_scans). The live service does not read
#                                   # scans, and says so at startup if this is set.
# SHIP_HAPPENS_RULES_FIRST=0        # stop reading the seven fields from labels before
#                                   # calling the model. On by default; off costs about
#                                   # 12 s per document pair.
# SHIP_HAPPENS_LIVE=1               # let the tests that reach a model actually run, so a
#                                   # key alone never turns a unit-test run into billed
#                                   # calls.
# LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR. A value it does not
#                                   # recognise falls back to INFO rather than silencing
#                                   # the service.
# CORS_ORIGINS=*                    # comma-separated origins allowed to call the API.
# UPLOAD_DIR=                       # where uploaded SI and BL files sit while they are checked, then deleted.
# MAILBOX_DIR=                      # where live mailbox attachments are written.
# MAILBOX_TTL_HOURS=24              # how long a checked email is kept in memory after last use.
# MAILBOX_MAX_MESSAGES=500          # checked emails kept per mailbox; the least recently used go first.
# MAILBOX_MAX_ACCOUNTS=1000         # mailboxes kept in memory at once.
# WEB_CONCURRENCY=1                 # worker processes; set by the host. Keep 1: mailboxes, the rate
#                                   # limit and the breakers are per process (#139).
